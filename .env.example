# 复制为 .env 并填写互动域的专用数据库身份；密码包含保留字符时需 URL 编码。
# 此变量供本仓 docker-compose.yml 使用；直接运行二进制时设置 DATABASE_URL。
COMMUNITY_DATABASE_URL=postgres://mf_community:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/metafusion_db?sslmode=disable

# 两个上游与本仓编排处于同一 metafusion-net 网络。
CATALOG_URL=http://backend:8080
AUTH_URL=http://auth:8081
COMMUNITY_JWKS_URL=http://auth:8081/api/oidc/jwks
AUTH_JWT_ISSUER=https://findverse.cc/api
AUTH_JWT_AUDIENCE=metafusion
